#!/bin/sh
# The commits of a range that GitHub vouches for as the release App's own, one id per line.
#   REPO=owner/name sh release-commits-verified <git log range arguments>
# A commit's author name and address are only git metadata, so for each commit whose author looks like the App this asks
# GitHub's own API two things, and lists the commit only when both answers hold:
#   the commit:       GitHub reports it verified, and its committer is web-flow (GitHub signed it);
#   its pull request: one of the pull requests holding the commit was opened by the App itself (a user of type Bot named
#                     morndo-release[bot]) from a release-please branch of this same repository, not from a fork.
# Anything else, and any failed API call, lists nothing. commit-traces still requires the exact identity, GitHub as
# committer and a diff of release files only; CI passes this list to it as COMMIT_TRACES_VERIFIED. Needs gh and jq.
# GitHub links a commit to its pull request a little after the push, and the traces run starts right after it (on the
# release pull request's head 9fe82f1d it asked 14 s after the commit, found no pull request, and a rerun passed). So the
# pull request is asked for up to RELEASE_PR_TRIES times (default 6), RELEASE_PR_WAIT seconds apart (default 10), before
# the commit is left out. Each commit left out gets one line on stderr naming the check it failed; stdout is the list.
set -eu
: "${REPO:?set REPO to owner/name}"
tries=${RELEASE_PR_TRIES:-6}
wait_s=${RELEASE_PR_WAIT:-10}

# 0 when one of the pull requests holding commit $1 is the App's own, on a release-please branch of this repository.
app_pull() {
  n=1
  while :; do
    if pulls=$(gh api "repos/$REPO/commits/$1/pulls" 2>/dev/null) &&
      printf '%s' "$pulls" | jq -e --arg repo "$REPO" 'any(.[]; .user.login == "morndo-release[bot]" and .user.type == "Bot" and (.head.ref | startswith("release-please--")) and .head.repo.full_name == $repo)' >/dev/null 2>&1; then
      return 0
    fi
    [ "$n" -lt "$tries" ] || return 1
    n=$((n + 1))
    sleep "$wait_s"
  done
}

skip() { echo "release-commits-verified: $1 left out: $2" >&2; }

for sha in $(git log --format=%H --author='morndo-release' "$@"); do
  commit=$(gh api "repos/$REPO/commits/$sha" 2>/dev/null) || { skip "$sha" "the commit API call failed"; continue; }
  printf '%s' "$commit" | jq -e '.commit.verification.verified == true and .committer.login == "web-flow"' >/dev/null 2>&1 ||
    { skip "$sha" "GitHub does not report it verified and committed by web-flow"; continue; }
  app_pull "$sha" || { skip "$sha" "no pull request of the App's on a release-please branch after $tries asks"; continue; }
  echo "$sha"
done

#!/bin/sh
# Reject a push that adds a secret, a home path, a private key, or a token.
# Added lines are checked, so a marker already in a file does not fail a later
# edit. A private-key header in a test or fixture file is a fixture. Only
# commits that are not on any remote are checked, so a branch that merges main
# never re-checks published history.
# Install with scripts/install-git-hooks.sh. Does not change git config.
#
# gitleaks 8.30.1 `protect` scans `git diff` (or `--staged`), not the commits
# in the push. Those commits are scanned with `gitleaks detect --log-opts`.
# Git passes "<local ref> <local sha> <remote ref> <remote sha>" on stdin.
# This script is never scanned: its patterns would match their own source.
set -eu

root=$(git rev-parse --show-toplevel)
cd "$root"

if ! command -v gitleaks >/dev/null 2>&1; then
  echo "pre-push: gitleaks is not on PATH (https://github.com/gitleaks/gitleaks/releases/tag/v8.30.1)" >&2
  exit 1
fi

zero=0000000000000000000000000000000000000000
ranges=$(mktemp)
patterns=$(mktemp)
paths=$(mktemp)
patch=$(mktemp)
hits=$(mktemp)
exc=$(mktemp)
merges=$(mktemp)
trap 'rm -f "$ranges" "$patterns" "$paths" "$patch" "$hits" "$exc" "$merges"' EXIT

gitleaks protect --no-banner --redact

scan_dir() {
  gitleaks dir . --config .gitleaks.toml --redact --no-banner
}

scan_push() {
  # stdin is not a terminal when git runs this hook.
  if [ -t 0 ]; then
    scan_dir
    return
  fi
  scanned=0
  while read -r local_ref local_sha remote_ref remote_sha; do
    [ -n "${local_sha:-}" ] || continue
    if [ "$local_sha" = "$zero" ]; then
      continue
    fi
    printf '%s %s\n' "$local_sha" "${remote_sha:-$zero}" >> "$ranges"
    case "${remote_sha:-$zero}" in
      "$zero")
        scan_dir ;;
      *)
        gitleaks detect --no-banner --redact --log-opts="${remote_sha}..${local_sha}" ;;
    esac
    scanned=1
  done
  if [ "$scanned" -eq 0 ]; then
    scan_dir
  fi
}

scan_push

# Generic markers only. Extra regexes, one per line, may live outside the
# tree at "$(git rev-parse --git-dir)/info/leak-patterns".
self=scripts/git-hooks/pre-push
listfile=scripts/git-hooks/leak-allowlist
home_re='/(home|Users)/[^/[:space:]]+/'
key_re='-----BEGIN [A-Z0-9 ]*PRIVATE KEY-----'
token_re='(ghp_|github_pat_|sk-|xox[baprs]-|AKIA)[A-Za-z0-9_]{16,}'
# Exact path and exact match, tab-separated. A different match in that file still fails.
# Resolved from this script so a proof can run it against another checkout.
allowlist=$(dirname "$(readlink -f "$0")")/leak-allowlist

allowed() {
  [ -f "$allowlist" ] || return 1
  needle=$(printf '%s\t%s' "$1" "$2")
  grep -F -x -q -- "$needle" "$allowlist"
}

# 0 when a private-key header sits in a test or fixture. A home path or a
# token in that file still fails.
obvious_fixture() {
  case "$1" in
    *.test.ts|*.test.tsx|*.test.js|*.test.mjs|*.e2e.ts|*.fixture.ts|*.fixture.js) ;;
    */test/*|*/tests/*|*/fixtures/*) ;;
    *) return 1 ;;
  esac
  printf '%s' "$2" | grep -E -q '^-----BEGIN [A-Z0-9 ]*PRIVATE KEY-----$'
}

skip_file() {
  case "$1" in
    "$self"|./"$self"|"$listfile"|./"$listfile") return 0 ;;
  esac
  return 1
}

extra=$(git rev-parse --git-dir)/info/leak-patterns
if [ -f "$extra" ]; then
  awk 'NF { print }' "$extra" > "$patterns"
fi

reject() {
  echo "pre-push: $*" >&2
  exit 1
}

search_failed() {
  echo "pre-push: pattern search failed" >&2
  exit 1
}

# Every match on one line. An allowlisted or fixture match does not hide a
# later match, or a local pattern, on that same line. A search error aborts.
scan_text() {
  file=$1
  text=$2
  status=0
  raw=$(printf '%s\n' "$text" | grep -o -E -e "$home_re" -e "$key_re" -e "$token_re") || status=$?
  [ "$status" -le 1 ] || search_failed
  if [ "$status" -eq 0 ]; then
    printf '%s\n' "$raw" > "$hits"
    while IFS= read -r one || [ -n "$one" ]; do
      [ -n "$one" ] || continue
      allowed "$file" "$one" && continue
      obvious_fixture "$file" "$one" && continue
      reject "home path, private key, or token in $file"
    done < "$hits"
  fi
  [ -s "$patterns" ] || return 0
  status=0
  printf '%s\n' "$text" | grep -E -q -f "$patterns" || status=$?
  [ "$status" -ne 0 ] || reject "local leak pattern in $file"
  [ "$status" -eq 1 ] || search_failed
}

scan_file() {
  file=$1
  skip_file "$file" && return 0
  status=0
  raw=$(grep -I -o -E -e "$home_re" -e "$key_re" -e "$token_re" -- "$file") || status=$?
  [ "$status" -le 1 ] || search_failed
  if [ "$status" -eq 0 ]; then
    printf '%s\n' "$raw" > "$hits"
    while IFS= read -r one || [ -n "$one" ]; do
      [ -n "$one" ] || continue
      allowed "$file" "$one" && continue
      obvious_fixture "$file" "$one" && continue
      reject "home path, private key, or token in $file"
    done < "$hits"
  fi
  [ -s "$patterns" ] || return 0
  status=0
  grep -I -q -E -f "$patterns" -- "$file" || status=$?
  [ "$status" -ne 0 ] || reject "local leak pattern in $file"
  [ "$status" -eq 1 ] || search_failed
}

# New-file length from a hunk header. Omitted count means one line.
hunk_new_lines() {
  rest=${1#*+}
  rest=${rest%% @@*}
  case "$rest" in
    *,*) rest=${rest#*,} ;;
    *) rest=1 ;;
  esac
  case "$rest" in
    *[!0-9]*|'') printf '0' ;;
    *) printf '%s' "$rest" ;;
  esac
}

# Added lines of a unified or a combined diff. Headers are read only outside
# a hunk, and a hunk is the number of new-file lines the header names. A
# marker already in the file is not an added line. In a combined hunk, which
# a merge carries, a line with a '-' column for any parent is not part of the
# result, and only a '+' in every column is new against them all.
scan_patch() {
  file=
  left=0
  cc=0
  parents=0
  while IFS= read -r line || [ -n "$line" ]; do
    if [ "$left" -gt 0 ]; then
      if [ "$cc" -eq 1 ]; then
        case "$line" in
          '\'*) continue ;;
        esac
        pre=$(printf '%.*s' "$parents" "$line")
        case "$pre" in
          *-*) continue ;;
          *' '*)
            left=$((left - 1))
            ;;
          *)
            left=$((left - 1))
            case "$file" in
              ''|/dev/null) ;;
              *) skip_file "$file" || scan_text "$file" "${line#"$pre"}" ;;
            esac
            ;;
        esac
        continue
      fi
      case "$line" in
        '\'*) continue ;;
        '-'*) continue ;;
        '+'*)
          text=${line#+}
          case "$file" in
            ''|/dev/null) ;;
            *) skip_file "$file" || scan_text "$file" "$text" ;;
          esac
          left=$((left - 1))
          ;;
        *)
          left=$((left - 1))
          ;;
      esac
      continue
    fi
    case "$line" in
      'diff --git '*)
        file=
        cc=0
        ;;
      'diff --cc '*)
        cc=1
        file=${line#diff --cc }
        case "$file" in
          *' b/'*) file=${file##* b/} ;;
          'a/'*) file=${file#a/} ;;
        esac
        ;;
      '+++ '*)
        file=${line#+++ }
        case "$file" in
          '"'*) file=${file#\"}; file=${file%\"} ;;
        esac
        file=${file#b/}
        ;;
      '@@@'*)
        cc=1
        parents=0
        left=1
        rest=${line#"${line%%[!@]*}"}
        rest=${rest%%@*}
        for word in $rest; do
          case "$word" in
            -*) parents=$((parents + 1)) ;;
            +*)
              count=${word#+}
              case "$count" in
                *,*) count=${count#*,} ;;
                *) count=1 ;;
              esac
              case "$count" in
                *[!0-9]*|'') count=0 ;;
              esac
              left=$count
              ;;
          esac
        done
        ;;
      '@@'*)
        cc=0
        left=$(hunk_new_lines "$line")
        ;;
    esac
  done < "$1"
}

git diff -U0 --diff-filter=ACMR -- . ":(exclude)$self" ":(exclude)$listfile" > "$patch"
scan_patch "$patch"
git diff --cached -U0 --diff-filter=ACMR -- . ":(exclude)$self" ":(exclude)$listfile" > "$patch"
scan_patch "$patch"
git ls-files --others --exclude-standard > "$paths"
while IFS= read -r file; do
  [ -n "$file" ] || continue
  skip_file "$file" && continue
  [ -f "$file" ] || continue
  scan_file "$file"
done < "$paths"

mails=$(dirname "$(readlink -f "$0")")/commit-traces
exceptions=scripts/git-hooks/traces-published-exceptions
# The published exceptions are read from the remote side of the push, never
# from the tree being pushed: a branch cannot list itself. A push that
# creates a ref has no remote side yet; then the list in the tree is the
# registry that travels with the repository.
load_exceptions() {
  : > "$exc"
  if [ "$1" = "$zero" ]; then
    list=$(dirname "$(readlink -f "$0")")/traces-published-exceptions
    if [ -f "$list" ]; then
      cat "$list" > "$exc"
    fi
    return 0
  fi
  git cat-file -e "$1:$exceptions" 2>/dev/null || return 0
  git show "$1:$exceptions" > "$exc"
}

# The patch a push would add is the net difference between the remote side
# and the local tip - a line added and removed inside the push is not
# checked - plus the changes a merge commit itself carries, which the net
# difference does not separate out. A push that creates a ref has no remote
# side; its base is the common boundary with the remote-tracking refs, or
# the empty tree when there is none, which scans the whole tree. The mail
# checks stay limited to commits that are not on any remote: the remote tip
# git reports and every remote-tracking ref.
while read -r local_sha remote_sha; do
  [ -n "${local_sha:-}" ] || continue
  load_exceptions "$remote_sha"
  sel=$local_sha
  if [ "$remote_sha" = "$zero" ]; then
    base=
    refs=$(git for-each-ref --format='%(refname)' refs/remotes)
    if [ -n "$refs" ]; then
      sel="$local_sha --not --remotes"
      base=$(git merge-base "$local_sha" $refs 2>/dev/null) || base=
    fi
    if [ -z "${base:-}" ]; then
      base=$(git hash-object -t tree /dev/null)
    fi
  else
    base=$remote_sha
    sel="$local_sha --not $remote_sha --remotes"
  fi
  TRACES_PUBLISHED_EXCEPTIONS="$exc" sh "$mails" mails $sel
  git diff -U0 --diff-filter=ACMR "$base" "$local_sha" -- . ":(exclude)$self" ":(exclude)$listfile" > "$patch" || search_failed
  scan_patch "$patch"
  git rev-list --merges $sel > "$merges" || search_failed
  while IFS= read -r merge || [ -n "$merge" ]; do
    [ -n "$merge" ] || continue
    git diff-tree --cc -U0 --no-commit-id --diff-filter=ACMR "$merge" -- . ":(exclude)$self" ":(exclude)$listfile" > "$patch" || search_failed
    scan_patch "$patch"
  done < "$merges"
done < "$ranges"

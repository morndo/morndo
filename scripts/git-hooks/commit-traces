#!/bin/sh
# Reject assistant attribution in a commit message, author, or committer.
# The author address must be @users.noreply.github.com. The committer address
# may also be GitHub's web-flow address, noreply@github.com.
#   sh commit-traces message FILE
#   sh commit-traces range <git rev-list args>
#   sh commit-traces mails <git rev-list args>
# A dependabot[bot] author, committer, or trailer is allowed. So is the release
# App's own release commit, and only that: an author name and address are git
# metadata any pusher can write, so the identity alone admits nothing. A commit is
# admitted only when ALL hold: its author is exactly RELEASE_BOT_NAME with
# RELEASE_BOT_MAIL; its committer is GitHub's web-flow; its whole id is a line of
# the file named by COMMIT_TRACES_VERIFIED (the ids GitHub's own API reported as
# verified; CI builds it, a local pre-push has none, so it admits no bot); it has
# exactly one parent; and it changes, as modifications only, nothing but release
# files: the version lines of package.json and package-lock.json, the root version of
# .release-please-manifest.json, lines added to CHANGELOG.md. Any other [bot]
# identity, a name or an address alone, or a lookalike is not admitted. Install the
# commit-msg hook with scripts/install-git-hooks.sh.
# COMMIT_TRACES_LEGACY: full commit ids, separated by spaces, whose author and
# committer addresses are not checked. For a commit already in the published
# history whose address cannot be rewritten; only its address is spared, by an
# exact match of the whole id. Nothing sets it but a proof (pre-push-proof.sh
# pins the one commit this repository has); never set it in CI or a hook.
# mails and range read the whole range with one git log into a temp file and
# judge it with one awk pass per concern, not a set of forks per commit. The
# per-commit rules stay in check_commit, run only for the candidates that the
# awk pass finds.
set -eu

names='claude|anthropic|cursor|codex|copilot|gpt|gemini|glm'
# The release App (Release Please commits the release PR as this identity). It is the id of the App's bot user and its
# slug, the address GitHub gives every App. The identity is one of several conditions (release_commit below), never enough.
RELEASE_BOT_NAME='morndo-release[bot]'
RELEASE_BOT_MAIL='345868531+morndo-release[bot]@users.noreply.github.com'
robot=$(printf '\360\237\244\226')
fs=$(printf '\037')
err=$(mktemp)
out=$(mktemp)
trap 'rm -f "$err" "$out"' EXIT

fail() {
  echo "commit-traces: $*" >&2
  exit 1
}

# 0 when an identity (a name, an address, or a trailer) attributes the change.
bad_ident() {
  text=$1
  printf '%s' "$text" | grep -E -i -q "(^|[^A-Za-z0-9])($names)([^A-Za-z0-9]|$)" && return 0
  printf '%s' "$text" | grep -E -i -q '[^[:space:]<>@]+@(anthropic\.com|cursor\.(com|sh)|openai\.com)' && return 0
  stripped=$(printf '%s' "$text" | sed 's/dependabot\[bot\]//g')
  printf '%s' "$stripped" | grep -F -q '[bot]' && return 0
  return 1
}

# A subject or body may name a product. Only attribution does not.
bad_message() {
  text=$1
  printf '%s' "$text" | grep -E -i -q 'generated[[:space:]]+(with|by)' && return 0
  printf '%s' "$text" | grep -F -q "$robot" && return 0
  printf '%s' "$text" | grep -E -i -q 'https?://[^[:space:]]*(claude\.ai|chatgpt\.com|chat\.openai\.com|cursor\.(com|sh))' && return 0
  printf '%s' "$text" | grep -E -i -q '[^[:space:]<>@]+@(anthropic\.com|cursor\.(com|sh)|openai\.com)' && return 0
  trailers=$(printf '%s\n' "$text" | grep -E -i '^(Co-authored-by|Signed-off-by):' || true)
  [ -n "$trailers" ] || return 1
  bad_ident "$trailers"
}

check_message() {
  if bad_message "$1"; then
    fail "message attributes the change to an assistant"
  fi
}

# 0 when the address is a GitHub noreply address. The local part may contain
# the brackets a [bot] address uses.
noreply_mail() {
  printf '%s' "$1" | grep -E -i -q '^[^@[:space:]]+@users\.noreply\.github\.com$'
}

# Web merges and the web editor commit as GitHub <noreply@github.com>.
github_committer() {
  printf '%s' "$1" | grep -E -i -q '^noreply@github\.com$'
}

check_mails() {
  sha=$1
  case " ${COMMIT_TRACES_LEGACY:-} " in *" $sha "*) return 0 ;; esac
  ae=$(git log -1 --format='%ae' "$sha")
  ce=$(git log -1 --format='%ce' "$sha")
  noreply_mail "$ae" || fail "$sha author email is not @users.noreply.github.com"
  if ! noreply_mail "$ce" && ! github_committer "$ce"; then
    fail "$sha committer email is not a noreply address"
  fi
}

# 0 when every line a diff changed is one of the allowed shapes. $1 and $2: the commit's parent and the commit; $3: the
# file; $4: an extended regex the changed lines (without their +/-) must match. The first four lines of a diff of a
# modified file are its headers.
only_lines() {
  git diff --no-renames --no-color -U0 "$1" "$2" -- "$3" | sed '1,4d' | grep -E '^[-+]' | grep -v -E "^[-+]($4)\$" | grep -q . && return 1
  return 0
}

# 0 when the commit changes nothing but release files, as plain modifications: one parent, no deleted, added, renamed or
# mode-changed file, the version lines of a package.json or package-lock.json, the root version of the release manifest, and
# only added lines in CHANGELOG.md. Fail closed on anything else.
release_files_only() {
  rf_sha=$1
  [ "$(git rev-list --parents -n 1 "$rf_sha" | wc -w)" -eq 2 ] || return 1
  rf_parent="$rf_sha^1"
  rf_files=$(git diff --no-renames --name-only --diff-filter=M "$rf_parent" "$rf_sha")
  [ -n "$rf_files" ] || return 1
  [ "$rf_files" = "$(git diff --no-renames --name-only "$rf_parent" "$rf_sha")" ] || return 1
  [ -z "$(git diff --no-renames --summary "$rf_parent" "$rf_sha")" ] || return 1
  version='[[:space:]]*"version": "[0-9A-Za-z.+-]+",?'
  manifest='[[:space:]]*"[.]": "[0-9A-Za-z.+-]+",?'
  for rf_file in $rf_files; do
    case "$rf_file" in
      package.json|*/package.json|package-lock.json|*/package-lock.json) only_lines "$rf_parent" "$rf_sha" "$rf_file" "$version" || return 1 ;;
      .release-please-manifest.json) only_lines "$rf_parent" "$rf_sha" "$rf_file" "$manifest" || return 1 ;;
      CHANGELOG.md)
        [ "$(git diff --no-renames --numstat "$rf_parent" "$rf_sha" -- "$rf_file" | cut -f2)" = 0 ] || return 1 ;;
      *) return 1 ;;
    esac
  done
  return 0
}

# 0 when the commit is the release App's own release commit (see the header): identity, GitHub as committer, listed as
# verified, release files only. $1: the commit; $2 to $5: author name and address, committer name and address.
release_commit() {
  [ "$2" = "$RELEASE_BOT_NAME" ] && [ "$3" = "$RELEASE_BOT_MAIL" ] || return 1
  [ "$4" = GitHub ] && [ "$5" = noreply@github.com ] || return 1
  [ -n "${COMMIT_TRACES_VERIFIED:-}" ] && [ -f "$COMMIT_TRACES_VERIFIED" ] || return 1
  grep -F -x -q "$1" "$COMMIT_TRACES_VERIFIED" || return 1
  release_files_only "$1"
}

check_commit() {
  sha=$1
  msg=$(git log -1 --format='%B' "$sha")
  if bad_message "$msg"; then
    fail "$sha message attributes the change to an assistant"
  fi
  # The release App's own release commit (release_commit) leaves its author identity out of the identity text; the
  # committer, GitHub, is judged as always, and the message is judged above, so an assistant beside it still fails.
  an=$(git log -1 --format='%an' "$sha")
  ae=$(git log -1 --format='%ae' "$sha")
  cn=$(git log -1 --format='%cn' "$sha")
  ce=$(git log -1 --format='%ce' "$sha")
  if release_commit "$sha" "$an" "$ae" "$cn" "$ce"; then an=''; ae=''; fi
  ident=$(printf '%s\n%s\n%s\n%s' "$an" "$ae" "$cn" "$ce")
  if bad_ident "$ident"; then
    fail "$sha author or committer names an assistant or a bot other than dependabot[bot]"
  fi
  check_mails "$sha"
}

# The whole range in one git log, into the out file. A failing git log (a
# missing sha, a bad range) must not look like a clean check.
log_all() {
  fmt=$1
  shift
  status=0
  git -c log.showSignature=false log --no-color --format="$fmt" "$@" >"$out" 2>"$err" || status=$?
  if [ "$status" -ne 0 ]; then
    cat "$err" >&2
    fail "revision range"
  fi
}

# One pass of both noreply rules and the legacy pin, in git's order, over a log
# of exactly id, author address and committer address, one line each, split at
# the unit separator. A name or an address that holds the separator shifts the
# fields, so a record that is not exactly three fields refuses (fail closed).
# The addresses are always read from this log, never from the one that also
# holds names and messages, where a crafted name could shift them.
scan_mails() {
  LC_ALL=C awk -v legacy=" ${COMMIT_TRACES_LEGACY:-} " -v fs="$fs" '
    BEGIN { FS = fs }
    {
      sub(/^[[:space:]]+/, "", $0)
      if ($0 == "") next
      if (NF != 3) {
        printf "commit-traces: %s record does not read as id, author and committer address\n", substr($0, 1, 40) > "/dev/stderr"
        exit 1
      }
      if (index(legacy, " " $1 " ")) next
      if (tolower($2) !~ /^[^@[:space:]]+@users[.]noreply[.]github[.]com$/) {
        printf "commit-traces: %s author email is not @users.noreply.github.com\n", $1 > "/dev/stderr"
        exit 1
      }
      if (tolower($3) !~ /^[^@[:space:]]+@users[.]noreply[.]github[.]com$/ &&
          tolower($3) != "noreply@github.com") {
        printf "commit-traces: %s committer email is not a noreply address\n", $1 > "/dev/stderr"
        exit 1
      }
    }' "$1"
}

# The ids bad_message or bad_ident can refuse: everything they match (a name,
# a vendor domain, generated with or by, their urls, trailers, [bot], the
# emoji) holds one of these markers, so a record holding none is clean by
# both. A record that does not start with a commit id (a message holding the
# record separator) refuses: fail closed, never skip.
candidates() {
  LC_ALL=C awk '
    BEGIN {
      FS = "\037"; RS = "\036"
      split("claude anthropic cursor codex copilot gpt gemini glm generated openai [bot] co-authored-by signed-off-by \360\237\244\226", mark, " ")
    }
    {
      sub(/^[[:space:]]+/, "", $0)
      if ($0 == "") next
      id = substr($0, 1, 40)
      if (length($0) < 40 || id ~ /[^0-9a-f]/) {
        printf "commit-traces: %s record is not a commit\n", id > "/dev/stderr"
        exit 1
      }
      text = tolower($0)
      for (m in mark) {
        if (index(text, mark[m])) {
          print id
          break
        }
      }
    }
' "$1"
}

# The mails mode: both noreply rules over the whole range in one pass.
mails() {
  [ "$#" -ge 1 ] || fail "usage: commit-traces $mode <rev-list>"
  log_all '%H%x1f%ae%x1f%ce' "$@"
  scan_mails "$out"
}

# The range mode: one pass finds the candidates, check_commit judges each
# one, then the mails mode's own log and pass cover the whole range.
range() {
  [ "$#" -ge 1 ] || fail "usage: commit-traces $mode <rev-list>"
  log_all '%H%x1f%an%x1f%ae%x1f%cn%x1f%ce%x1f%B%x1e' "$@"
  list=$(candidates "$out")
  for sha in $list; do
    check_commit "$sha"
  done
  log_all '%H%x1f%ae%x1f%ce' "$@"
  scan_mails "$out"
}

[ "$#" -ge 1 ] || fail "usage: commit-traces message FILE | commit-traces range <rev-list> | commit-traces mails <rev-list>"

mode=$1
shift
case "$mode" in
  message)
    [ "$#" -eq 1 ] || fail "usage: commit-traces message FILE"
    [ -f "$1" ] || fail "no message file: $1"
    # The editor file still has git's comment block and, with -v, the scissors
    # diff. Those are not part of the message.
    check_message "$(awk '/^# -+ >8 -+/ { exit } /^#/ { next } { print }' "$1")"
    ;;
  range)
    range "$@"
    ;;
  mails)
    mails "$@"
    ;;
  *)
    fail "usage: commit-traces message FILE | commit-traces range <rev-list> | commit-traces mails <rev-list>"
    ;;
esac

#!/bin/sh
# Reject assistant attribution in a commit message, author, or committer.
# The author address must be @users.noreply.github.com. The committer address
# may also be GitHub's web-flow address, noreply@github.com.
#   sh commit-traces message FILE
#   sh commit-traces range <git rev-list args>
#   sh commit-traces mails <git rev-list args>
# A dependabot[bot] author, committer, or trailer is allowed. Any other
# [bot] identity is not. Install the commit-msg hook with
# scripts/install-git-hooks.sh.
# COMMIT_TRACES_LEGACY: full commit ids, separated by spaces, whose author and
# committer addresses are not checked. For a commit already in the published
# history whose address cannot be rewritten; only its address is spared, by an
# exact match of the whole id. Nothing sets it but a proof (pre-push-proof.sh
# pins the one commit this repository has); never set it in CI or a hook.
# mails and range read the whole range with one git log into a temp file and
# judge it with one awk pass per concern, not a set of forks per commit. The
# per-commit rules stay in check_commit, run only for the candidates that the
# awk pass finds.
set -eu

names='claude|anthropic|cursor|codex|copilot|gpt|gemini|glm'
robot=$(printf '\360\237\244\226')
fs=$(printf '\037')
rs=$(printf '\036')
err=$(mktemp)
out=$(mktemp)
trap 'rm -f "$err" "$out"' EXIT

fail() {
  echo "commit-traces: $*" >&2
  exit 1
}

# 0 when an identity (a name, an address, or a trailer) attributes the change.
bad_ident() {
  text=$1
  printf '%s' "$text" | grep -E -i -q "(^|[^A-Za-z0-9])($names)([^A-Za-z0-9]|$)" && return 0
  printf '%s' "$text" | grep -E -i -q '[^[:space:]<>@]+@(anthropic\.com|cursor\.(com|sh)|openai\.com)' && return 0
  stripped=$(printf '%s' "$text" | sed 's/dependabot\[bot\]//g')
  printf '%s' "$stripped" | grep -F -q '[bot]' && return 0
  return 1
}

# A subject or body may name a product. Only attribution does not.
bad_message() {
  text=$1
  printf '%s' "$text" | grep -E -i -q 'generated[[:space:]]+(with|by)' && return 0
  printf '%s' "$text" | grep -F -q "$robot" && return 0
  printf '%s' "$text" | grep -E -i -q 'https?://[^[:space:]]*(claude\.ai|chatgpt\.com|chat\.openai\.com|cursor\.(com|sh))' && return 0
  printf '%s' "$text" | grep -E -i -q '[^[:space:]<>@]+@(anthropic\.com|cursor\.(com|sh)|openai\.com)' && return 0
  trailers=$(printf '%s\n' "$text" | grep -E -i '^(Co-authored-by|Signed-off-by):' || true)
  [ -n "$trailers" ] || return 1
  bad_ident "$trailers"
}

check_message() {
  if bad_message "$1"; then
    fail "message attributes the change to an assistant"
  fi
}

# 0 when the address is a GitHub noreply address. The local part may contain
# the brackets a [bot] address uses.
noreply_mail() {
  printf '%s' "$1" | grep -E -i -q '^[^@[:space:]]+@users\.noreply\.github\.com$'
}

# Web merges and the web editor commit as GitHub <noreply@github.com>.
github_committer() {
  printf '%s' "$1" | grep -E -i -q '^noreply@github\.com$'
}

check_mails() {
  sha=$1
  case " ${COMMIT_TRACES_LEGACY:-} " in *" $sha "*) return 0 ;; esac
  ae=$(git log -1 --format='%ae' "$sha")
  ce=$(git log -1 --format='%ce' "$sha")
  noreply_mail "$ae" || fail "$sha author email is not @users.noreply.github.com"
  if ! noreply_mail "$ce" && ! github_committer "$ce"; then
    fail "$sha committer email is not a noreply address"
  fi
}

check_commit() {
  sha=$1
  msg=$(git log -1 --format='%B' "$sha")
  if bad_message "$msg"; then
    fail "$sha message attributes the change to an assistant"
  fi
  ident=$(git log -1 --format='%an%n%ae%n%cn%n%ce' "$sha")
  if bad_ident "$ident"; then
    fail "$sha author or committer names an assistant or a bot other than dependabot[bot]"
  fi
  check_mails "$sha"
}

# The whole range in one git log, into the out file. A failing git log (a
# missing sha, a bad range) must not look like a clean check.
log_all() {
  fmt=$1
  shift
  status=0
  git -c log.showSignature=false log --no-color --format="$fmt" "$@" >"$out" 2>"$err" || status=$?
  if [ "$status" -ne 0 ]; then
    cat "$err" >&2
    fail "revision range"
  fi
}

# One pass of both noreply rules and the legacy pin, in git's order. af and cf
# pick the author and committer address fields; recs says the records end in
# the record separator (0x1e), not a newline, because a message can hold
# line breaks.
scan_mails() {
  LC_ALL=C awk -v af="$1" -v cf="$2" -v recs="$3" -v legacy=" ${COMMIT_TRACES_LEGACY:-} " -v fs="$fs" -v rs="$rs" '
    BEGIN { FS = fs; if (recs + 0) RS = rs }
    {
      sub(/^[[:space:]]+/, "", $0)
      if ($0 == "") next
      if (index(legacy, " " $1 " ")) next
      if (tolower($af) !~ /^[^@[:space:]]+@users[.]noreply[.]github[.]com$/) {
        printf "commit-traces: %s author email is not @users.noreply.github.com\n", $1 > "/dev/stderr"
        exit 1
      }
      if (tolower($cf) !~ /^[^@[:space:]]+@users[.]noreply[.]github[.]com$/ &&
          tolower($cf) != "noreply@github.com") {
        printf "commit-traces: %s committer email is not a noreply address\n", $1 > "/dev/stderr"
        exit 1
      }
    }' "$4"
}

# The ids bad_message or bad_ident can refuse: everything they match (a name,
# a vendor domain, generated with or by, their urls, trailers, [bot], the
# emoji) holds one of these markers, so a record holding none is clean by
# both. A record that does not start with a commit id (a message holding the
# record separator) refuses: fail closed, never skip.
candidates() {
  LC_ALL=C awk '
    BEGIN {
      FS = "\037"; RS = "\036"
      split("claude anthropic cursor codex copilot gpt gemini glm generated openai [bot] co-authored-by signed-off-by \360\237\244\226", mark, " ")
    }
    {
      sub(/^[[:space:]]+/, "", $0)
      if ($0 == "") next
      id = substr($0, 1, 40)
      if (length($0) < 40 || id ~ /[^0-9a-f]/) {
        printf "commit-traces: %s record is not a commit\n", id > "/dev/stderr"
        exit 1
      }
      text = tolower($0)
      for (m in mark) {
        if (index(text, mark[m])) {
          print id
          break
        }
      }
    }
' "$1"
}

# The mails mode: both noreply rules over the whole range in one pass.
mails() {
  [ "$#" -ge 1 ] || fail "usage: commit-traces $mode <rev-list>"
  log_all '%H%x1f%ae%x1f%ce' "$@"
  scan_mails 2 3 0 "$out"
}

# The range mode: one pass finds the candidates, check_commit judges each
# one, then the same mail pass as mails mode covers the whole range.
range() {
  [ "$#" -ge 1 ] || fail "usage: commit-traces $mode <rev-list>"
  log_all '%H%x1f%an%x1f%ae%x1f%cn%x1f%ce%x1f%B%x1e' "$@"
  list=$(candidates "$out")
  for sha in $list; do
    check_commit "$sha"
  done
  scan_mails 3 5 1 "$out"
}

[ "$#" -ge 1 ] || fail "usage: commit-traces message FILE | commit-traces range <rev-list> | commit-traces mails <rev-list>"

mode=$1
shift
case "$mode" in
  message)
    [ "$#" -eq 1 ] || fail "usage: commit-traces message FILE"
    [ -f "$1" ] || fail "no message file: $1"
    # The editor file still has git's comment block and, with -v, the scissors
    # diff. Those are not part of the message.
    check_message "$(awk '/^# -+ >8 -+/ { exit } /^#/ { next } { print }' "$1")"
    ;;
  range)
    range "$@"
    ;;
  mails)
    mails "$@"
    ;;
  *)
    fail "usage: commit-traces message FILE | commit-traces range <rev-list> | commit-traces mails <rev-list>"
    ;;
esac

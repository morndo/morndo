{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Preferences: the user's own file",
  "description": "The shape of the user's own preferences file (~/.config/morndo-knowledge/preferences.yaml), never shipped with anyone's content: each entry is shown as its holder's preference, never as a fact (K4, K12).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "preferences"
  ],
  "properties": {
    "preferences": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/preference"
      }
    }
  },
  "$defs": {
    "preference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "holder",
        "on",
        "said",
        "tasks"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$",
          "description": "What an SOP step cites: pref:<id>."
        },
        "holder": {
          "type": "string",
          "minLength": 1,
          "description": "Whose view it is; principal is shown as \"your\"."
        },
        "on": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "description": "When they said it."
        },
        "said": {
          "type": "string",
          "minLength": 1,
          "description": "Their words."
        },
        "tasks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          },
          "description": "The SOP steps it speaks to."
        }
      }
    }
  }
}

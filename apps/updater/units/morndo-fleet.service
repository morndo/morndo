# The fleet's user unit (design §5): the same rules as the hub's, the launcher's own name apart.
[Unit]
Description=Morndo fleet

[Service]
ExecStart=%h/.local/bin/morndo-fleet serve
Restart=on-failure
RestartSec=5
# Exit 78 is "fix the setup, don't restart" in every Morndo service (EX_CONFIG, §8.4).
RestartPreventExitStatus=78

[Install]
WantedBy=default.target

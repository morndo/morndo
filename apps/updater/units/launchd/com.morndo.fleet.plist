<?xml version="1.0" encoding="UTF-8"?>
<!-- The fleet's agent (design §5): the same rules as the hub's, the program's own name apart. -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.morndo.fleet</string>
  <key>ProgramArguments</key>
  <array>
    <string>@HOME@/.local/bin/morndo-fleet</string>
    <string>serve</string>
  </array>
  <key>KeepAlive</key>
  <dict>
    <key>SuccessfulExit</key>
    <false/>
  </dict>
  <key>ThrottleInterval</key>
  <integer>10</integer>
  <key>RunAtLoad</key>
  <true/>
</dict>
</plist>

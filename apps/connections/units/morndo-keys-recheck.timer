# Five minutes after boot, then every hour, spread by up to five minutes. A probe costs a fraction of a cent and only a member
# that is due is probed (24 hours after it ran dry by default, later after a failed probe, at the date a spend limit named),
# so the hour is the finest the check can happen, not the rate. Persistent=true (systemd.timer(5)) fires a run a sleeping
# machine missed, on its next start. Install: systemctl --user enable --now morndo-keys-recheck.timer
[Unit]
Description=Recheck the exhausted keys of the key pools every hour

[Timer]
OnBootSec=5min
OnUnitActiveSec=1h
RandomizedDelaySec=5min
Persistent=true

[Install]
WantedBy=timers.target

# The adoption rehearsal's own copy of the machine (e2e/update-adopt.e2e.ts, C6-0): the same machine as
# Dockerfile.fleet under its own label only, morndo-c6-adopt-e2e, so no other run's sweep ever sees it. One difference:
# the entrypoint. Rootless Docker refuses the remount of /sys/fs/cgroup, so when it is refused the entrypoint mounts a
# fresh cgroup2 of this container's own namespace and binds it over /sys/fs/cgroup (same capabilities, no --privileged).
FROM ubuntu:24.04

# systemd wants a few packages to behave like a machine: systemd itself, dbus-user-session so the user manager
# has its bus (the agent's tmux hosting and every systemctl --user the updater runs need it), tmux for the agent,
# sqlite3 for the scenario's database checks, ca-certificates, curl and openssh-client for anything that leaves the machine (install.sh of the published rehearsal needs both).
RUN apt-get update \
  && apt-get install -y --no-install-recommends systemd systemd-sysv dbus-user-session tmux sqlite3 ca-certificates curl openssh-client \
  && rm -rf /var/lib/apt/lists/*

# The user everything runs as: uid 1000, a home of its own, and lingering on from the start (§5: the services
# must survive the login session that installed them — install refuses without it). The base image already
# spends uid 1000 on its own `ubuntu` user, so that one is renamed into worker rather than the uid fought over.
RUN usermod --login worker --home /srv/worker --move-home ubuntu \
  && groupmod --new-name worker ubuntu \
  && mkdir -p /var/lib/systemd/linger \
  && touch /var/lib/systemd/linger/worker

# Without --privileged, Docker mounts the container's (private) cgroup tree read-only, and systemd as PID 1 cannot
# make its own scopes. The entrypoint makes it writable (a remount where the host allows it, a fresh cgroup2 mount
# bound over it where it does not: rootless Docker) and becomes /sbin/init. If neither works it says so and exits 77.
RUN printf '#!/bin/sh\nif ! mount -o remount,rw /sys/fs/cgroup 2>/dev/null; then\n  mkdir -p /mnt/cg && mount -t cgroup2 none /mnt/cg && mount --bind /mnt/cg /sys/fs/cgroup || { echo "e2e-init: cannot make /sys/fs/cgroup writable"; exit 77; }\nfi\nexec /sbin/init\n' > /usr/local/sbin/e2e-init \
  && chmod 0755 /usr/local/sbin/e2e-init

LABEL morndo-c6-adopt-e2e=1
STOPSIGNAL SIGRTMIN+3
CMD ["/usr/local/sbin/e2e-init"]
